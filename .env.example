# -----------------------------------------------------------------------------
# RakshaSphere Environment Configuration Template
# Copy this file to .env and fill in the values before running docker-compose
# -----------------------------------------------------------------------------

# Database Configuration
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=rakshaspheredb
MYSQL_USER=raksha_user
MYSQL_PASSWORD=change_this_user_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_at_least_256_bits_here
JWT_EXPIRATION_MS=86400000

# Backend Configuration
FRONTEND_URL=https://localhost
RATE_LIMIT_MAX_REQUESTS=100

# External Threat Intelligence APIs
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AI Engine Configuration
# AI_ENGINE_URL=http://ai-engine:5000
