# -----------------------------------------------------------------------------
# RakshaSphere Environment Configuration Template (.env.example)
# Copy this file to .env and fill in production values before starting containers
# -----------------------------------------------------------------------------

# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=rakshaspheredb
MYSQL_USER=raksha_user
MYSQL_PASSWORD=your_secure_db_user_password_here

# JWT Configuration (Must be at least 256 bits / 32 characters)
JWT_SECRET=your_production_jwt_secret_key_at_least_256_bits_long_1234567890
JWT_EXPIRATION_MS=86400000

# Backend Configuration
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_MAX_REQUESTS=100

# External Threat Intelligence APIs (Optional - Leaves feeds unconfigured if blank)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
